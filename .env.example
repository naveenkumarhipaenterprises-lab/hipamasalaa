# ==============================================================================
# HIPA MASALA - ENVIRONMENT VARIABLES
# Copy this file to .env for local development (.env is git-ignored).
# On Vercel, add the same names under Project Settings > Environment Variables.
# ==============================================================================

PORT=3000

# ------------------------------------------------------------------------------
# 1. SUPABASE (database + customer login)
# Supabase dashboard > Project Settings > API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Public "anon" key: safe in the browser, Row Level Security protects the data
SUPABASE_ANON_KEY=
# Secret "service_role" key: SERVER ONLY. Never put it in browser code or share it.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. RAZORPAY (payments)
# Razorpay dashboard > Settings > API Keys. Use rzp_test_ keys until go-live.
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard > Settings > Webhooks, URL: https://<your-site>/api/payment/webhook
RAZORPAY_WEBHOOK_SECRET=

# Simulated payments (no money moves). Defaults to true locally, false in production.
# ALLOW_TEST_PAYMENTS=false

# ------------------------------------------------------------------------------
# 3. ADMIN PANEL (/admin.html)
# Long random passphrase, at least 12 characters. Admin is disabled until set.
# ------------------------------------------------------------------------------
ADMIN_SECRET_KEY=
