# ==============================================================================
# HIPA MASALAS — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================

# Server Port
PORT=3000

# ------------------------------------------------------------------------------
# 1. RAZORPAY PAYMENT GATEWAY CREDENTIALS (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Get your API keys from Razorpay Dashboard: Settings > API Keys
# NEVER expose RAZORPAY_KEY_SECRET to frontend/browser code!
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# Public Key for Frontend Checkout initialization
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
# Set a strong secret passphrase for /admin panel access
ADMIN_SECRET_KEY=hipa_admin_2026_secure_key

# ------------------------------------------------------------------------------
# 3. SUPABASE POSTGRESQL DATABASE (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@db.vkmjklxquidqopkvdzvy.supabase.co:5432/postgres
SUPABASE_URL=https://vkmjklxquidqopkvdzvy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YourSupabaseServiceRoleKeyHere
